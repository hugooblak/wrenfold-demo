{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wrenfold/faq-list",
	"version": "1.0.0",
	"title": "FAQ list",
	"category": "widgets",
	"icon": "editor-help",
	"description": "Shows FAQs from the FAQ library as questions that open and close. Pick a topic, or show all.",
	"keywords": [ "faq", "questions", "accordion", "help" ],
	"textdomain": "wrenfold-faq",
	"attributes": {
		"topic": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
