{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Card",
	"slug": "card",
	"blockTypes": [
		"core/group",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"border": {
			"color": "var(--wp--preset--color--line)",
			"width": "1px",
			"style": "solid",
			"radius": "14px"
		},
		"spacing": {
			"padding": {
				"top": "1.75rem",
				"bottom": "1.75rem",
				"left": "1.75rem",
				"right": "1.75rem"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		}
	}
}
